# ai-specs/.env.example — committed template (safe to regenerate).
# Copy values into ai-specs/.env (gitignored). Root .envrc loads this via direnv.
# Generated from enabled recipes' [[provides.mcp]] env references.

CANONICAL_VAULT_PATH=  # required by vault-canonical (vault-canonical-store); Absolute path to the project-scoped vault folder (the only env the vault MCP reads). Example: /Users/you/.../vault/nnodes/proyectos/app. Must be fully resolved — do not leave nested $OTHER_VAR unexpanded.
TRELLO_API_KEY=  # required by trello (trello-mcp-workflow); Trello API key — create at https://trello.com/power-ups/admin
TRELLO_TOKEN=  # required by trello (trello-mcp-workflow); Trello token — generate from https://trello.com/power-ups/admin (Power-Up → API key page → Token)
