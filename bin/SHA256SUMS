6b5f8281e96e89f992a52e4c01ac8de2318a2a7746614b9a1a3efa33cabdefab  ai-specs-darwin-arm64
a763846fc838bb62f2f0e96dddecc4a2a859ae661d9da7fb4eb1de4b0f47c51d  ai-specs-linux-amd64
a46fbebdd81f29399e01f010df39e9e46532cb4c6e66d8c43fbee51d0487f1b7  ai-specs-linux-arm64
