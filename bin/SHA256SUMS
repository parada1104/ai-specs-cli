f36907335f1916fdd5e466b847e3f5365db0a662c6349596f4fb47febe85bbbf  ai-specs-darwin-arm64
256781c3117fd1e7a5e86ee3b229c96bcbe4b9e0cb3ece6da3078453f649b034  ai-specs-linux-amd64
ef269a4587efac9929e444ebc7d13cb85592f8f10b0c6aacdca35e97c6cda22c  ai-specs-linux-arm64
