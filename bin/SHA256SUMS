9dd092ddd80e824633015ba04d9e331f9329d5228b3a6e28af7daafa73e5d455  ai-specs-darwin-arm64
028ee7d19936e4cff326edcc255e264cce0038967be0b79e32679af4d444e618  ai-specs-linux-amd64
99607aedb237960171352b166dfc6d33efe8e3e78c162e522f10704cf038f169  ai-specs-linux-arm64
