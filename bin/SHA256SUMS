5a76b122f07eb65a626618f0517420ad75742fd74f7398627412fd0adcf13988  ai-specs-darwin-arm64
8b00414509c8aae7e957568ff5a27104d982c7e588ca51beb17e636c6a8758b1  ai-specs-linux-amd64
c2c1bdec95533360224e0ecae9fb294516ae2485142454ff36da5db52f80afae  ai-specs-linux-arm64
