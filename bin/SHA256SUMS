f33a49fa25c8f8c6867931a13f8e211e42326de59209d06ae52a60ab5e1ccf45  ai-specs-darwin-arm64
4a533b6b0cf707d40799ab0954d808263f86bc1aeb883604fa6d49e216b8cfbc  ai-specs-linux-amd64
71dcda511a25a07576e3ead1aca0fffdf41d72af07771add8442ddbc7cf486cf  ai-specs-linux-arm64
