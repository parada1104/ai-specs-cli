3333e9e2e1f13bccddb123c1ce500fc3a52e6a5fc3934421146971bf467d1e23  ai-specs-darwin-arm64
1a0ea2723c37f414a597571dc1ed22c335047e6ebbcbcae9b7657b056d21313a  ai-specs-linux-amd64
01a5629fb854e23f0b611c7245aae2eff4a513cd39613113f880a629bfddab5a  ai-specs-linux-arm64
