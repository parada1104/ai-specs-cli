d7aa2ae4f75b898996ebc24772e5acfde4413ff5318eda570beaca6bfff403d0  ai-specs-darwin-arm64
8d611720f484064ee564d125f24420a820db8c96d410c36917cfd0c3883a8fa1  ai-specs-linux-amd64
aaeae58d819d041cf409b6dd3d84c9ed31842df4335db263c40760fd1e5bde54  ai-specs-linux-arm64
