f17b82fe3acada06b741e2b7b563fabdddf811fe29502cf8a54c3cedb3fee2b2  ai-specs-darwin-arm64
dd62c4475d5a68b7c8ecbc029a56e98de4ee41b28d9a955e0add685c5ec5f287  ai-specs-linux-amd64
d8add72185956849f6ef6a69a0b6d329b38cab0d908ee64aeb6b840af63e2b5f  ai-specs-linux-arm64
