acc2cff72d82a43d1539832aa4846fb4d3538fd1b84098ac71e1e1f0c22fec47  ai-specs-darwin-arm64
7ea2d60cab45371cf722eef343b6903e014c5cb1a1b594a68e1f6dc26fbd4475  ai-specs-linux-amd64
cb2c3a2ea3d45449a935adbaa343d7ad7a6d11efc3daf1911cb0efb3ba6530f0  ai-specs-linux-arm64
