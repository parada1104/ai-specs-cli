#!/usr/bin/env bash
# ai-specs — global CLI for the ai-specs standard.
#
# Subcommands:
# init [path] Bootstrap ai-specs/ in a project (idempotent)
# sync [path] Reconcile manifest → refresh-bundled + vendor + AGENTS.md + agents
# sync-agent [path] [--all|--<a>] Fan out per-agent configs only
# refresh-bundled [path] Flatten CLI-bundled skills/commands into the cache
# add-dep <url> [path] Register a vendored skill (alias for 'skills add')
# doctor [path] Diagnose project health (read-only)
# rules-audit [path] Inventory legacy rules for migration planning (read-only)
# recipe list [path] List available and installed recipes
# recipe add <id> [path] Add a recipe to the manifest
# recipe init <id> [path] Print a read-only recipe init brief
# upgrade [--dry-run] [--force] Upgrade the global installation safely
# version Print CLI version
# hub [path] Interactive status + command menu (also bare `ai-specs`)
# help Show this help
set -e
SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
    DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
BIN_DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
AI_SPECS_HOME="${AI_SPECS_HOME:-$(cd "$BIN_DIR/.." && pwd)}"
export AI_SPECS_HOME
LIB_DIR="$AI_SPECS_HOME/lib"
if [[ $# -eq 0 ]]; then
    cmd="hub"
else
    cmd="$1"
    shift
fi
case "$cmd" in
hub) bash "$LIB_DIR/hub.sh" "$@" ;;
init) bash "$LIB_DIR/init.sh" "$@" ;;
sync) bash "$LIB_DIR/sync.sh" "$@" ;;
sync-agent) bash "$LIB_DIR/sync-agent.sh" "$@" ;;
refresh-bundled) bash "$LIB_DIR/refresh-bundled.sh" "$@" ;;
add-dep) bash "$LIB_DIR/skills-add.sh" "$@" ;;
skills) bash "$LIB_DIR/skills.sh" "$@" ;;
doctor) bash "$LIB_DIR/doctor.sh" "$@" ;;
rules-audit) bash "$LIB_DIR/rules-audit.sh" "$@" ;;
recipe) bash "$LIB_DIR/recipe.sh" "$@" ;;
configure-recipes) bash "$LIB_DIR/recipe-config.sh" "$@" ;;
upgrade) bash "$LIB_DIR/upgrade.sh" "$@" ;;
version|-v|--version) bash "$LIB_DIR/version.sh" ;;
help|-h|--help) cat <<EOF
ai-specs — declarative per-project AI agent config
Usage: ai-specs <command> [args]
Commands:
  init [path] Bootstrap ai-specs/ in a project (TTY opens onboarding)
  sync [path] Refresh bundled + vendor deps + regen AGENTS.md + sync agents
  sync-agent [path] [--all | --<agent>] Fan out per-agent configs only
  refresh-bundled [path] Flatten CLI-bundled skills/commands into the cache (no in-project writes)
  add-dep <url> [path] Register a vendored skill (alias for 'skills add')
  doctor [path] Diagnose project health (read-only)
  rules-audit [path] Inventory legacy rules for migration planning (read-only)
  skills add <url> [path] [flags] Register a vendored skill ([[deps]]) and sync
  skills list [path]          List registered and installed skills
  skills remove <id> [path]   Remove a vendored skill from the manifest
  recipe list [path]          List available and installed recipes
  recipe add <id> [path]      Add a recipe to the manifest
  recipe init <id> [path]     Print a read-only recipe init brief
  configure-recipes [path]    Configure recipe config, CLI deps, .envrc.example
  upgrade [--dry-run] [--force] Upgrade the global installation safely
  version Print CLI version
  help Show this help
Path defaults to current directory. Run any subcommand with --help for details.
Repo: https://github.com/parada1104/ai-specs-cli
EOF
;;
*) echo "ai-specs: unknown command '$cmd'" >&2
   echo "Run 'ai-specs help' for usage." >&2
   exit 2 ;;
esac
